initialize() {
        initializeSLiMModelType("nonWF");
        if (exists("slimgui")) {
                defineConstant("N",1000);
                defineConstant("rab",0.000005);
                defineConstant("sb",0.1);
                defineConstant("sa",0.002);
                defineConstant("mu",0.0000005);
                defineConstant("equgen",4000);
                defineConstant("totgen",7000);
                defineConstant("sampledind",500);
                defineConstant("rep",3);
        }
        
        defineConstant("GEN_EQU", equgen);
        defineConstant("GEN_TOT", totgen);

        defineConstant("SIM_ID", getSeed());
        initializeMutationRate(mu);

        // deleterious allele with selection coefficient sd and fully dominant (because of haploid selection)
        initializeMutationType("m1", 1.0, "f", -sa);
        // balanced allele under negative frequency-dependent selection (implemented when fitness is rescaled as a late event)
        initializeMutationType("m2", 0.5, "f", 0.0);

        // g1 genomic element type: uses m1 for all mutations
        initializeGenomicElementType("g1", m1, 1.0);
        initializeGenomicElementType("g2", m2, 1.0);

        // 2 sites along the chromosome
         initializeRecombinationRate(rab);
        	initializeGenomicElement(g1, 0, 24999);
			initializeGenomicElement(g2, 25000, 25000);
			initializeGenomicElement(g1, 25001, 50000);

        c(m1).convertToSubstitution = T;
        m1.mutationStackPolicy = "f";
        m2.mutationStackPolicy = "f";
}

1 early() {
        sim.addSubpop("p1", N, haploid=T);
        //setwd("/home/roman/Dropbox/Post_doc_Edinburgh/Model/Slim_simulations/simul_fitness_diff_track_bal_haplo/");
        setwd("/home/rstetsen/hitchhiking_slim/multilocus_haploid_haplo_track/");
        sim.chromosome.setMutationRate(c(mu,0,mu),c(24999,25000,50000));
        sim.setValue("counter", 0);
        	writeFile(paste("num_del_mut_N",N,"_sb",sb,"_sa",sa,"_rab",rab,"_mu",mu,"_equgen",equgen,"_totgen",totgen,"_sampledind",sampledind,"_rep",rep,"_bal0.txt",sep=""), paste("generation","sample_size","num_seg_del_mut","num_fix_del_mut","load","freq_bal","num_seg_del_haplo1","num_seg_del_haplo0","bal_sel"),append=F);
		writeFile(paste("num_del_mut_N",N,"_sb",sb,"_sa",sa,"_rab",rab,"_mu",mu,"_equgen",equgen,"_totgen",totgen,"_sampledind",sampledind,"_rep",rep,"_bal1.txt",sep=""), paste("generation","sample_size","num_seg_del_mut","num_fix_del_mut","load","freq_bal","num_seg_del_haplo1","num_seg_del_haplo0","bal_sel"),append=F);
}

GEN_EQU late () {
			sim.chromosome.setMutationRate(0.0);
			if (sim.getValue("counter") == 1)
			{
        		target=sample(p1.individuals,1);
        		target.haploidGenome1.addNewDrawnMutation(m2,25000);
        	} else {
        		sim.setValue("equ_num_fixed_del_mut", size(sim.substitutionsOfType(m1)));
        		defineConstant("CHECKPOINT", "slim_" + SIM_ID + ".txt");
        		sim.outputFull(CHECKPOINT);
        }
}

(GEN_EQU+1):GEN_TOT early () {

	if (sim.cycle % 10 == 0)
	{
			sampled_ind = sample(sim.subpopulations.individuals, sampledind);

			inds = p1.individuals;
       
      	num_mut_seg = size(sampled_ind.haploidGenome1.mutationsOfType(m1)	[sampled_ind.haploidGenome1.mutationsOfType(m1).isSegregating==T])/sampledind;
      	
      	bal_freq = size(inds.haploidGenome1[inds.haploidGenome1.countOfMutationsOfType(m2)==1])/(2*N);

      	ind_bal_1=inds.haploidGenome1[inds.haploidGenome1.countOfMutationsOfType(m2)==1];
      	
      	ind_bal_0=inds.haploidGenome1[inds.haploidGenome1.countOfMutationsOfType(m2)==0];
      	
      	num_mut_haplo_bal_1=size(ind_bal_1.mutationsOfType(m1)	[ind_bal_1.mutationsOfType(m1).isSegregating==T])/size(ind_bal_1);
      	
      	num_mut_haplo_bal_0=size(ind_bal_0.mutationsOfType(m1)	[ind_bal_0.mutationsOfType(m1).isSegregating==T])/size(ind_bal_0);
      	
      	if (sim.getValue("counter") == 1)
      { 
      		num_mut_fix = size(sim.substitutionsOfType(m1));
      	} else {
      		num_mut_fix = size(sim.substitutionsOfType(m1))-sim.getValue("equ_num_fixed_del_mut");
      	}
      
      	fit = rep(0.0,N);

	for (i in seqLen(N)) {
         	       ind = inds[i];
            	    	delmutcount=size(ind.haploidGenome1.mutationsOfType(m1))+num_mut_fix;

                	fit[i] = (1.0-sd)^delmutcount;      
       }
       
       mean_fit = mean(fit);
	
			if (sim.getValue("counter") == 1)
			{
					writeFile(paste("num_del_mut_N",N,"_sb",sb,"_sa",sa,"_rab",rab,"_mu",mu,"_equgen",equgen,"_totgen",totgen,"_sampledind",sampledind,"_rep",rep,"_bal1.txt",sep=""), paste(sim.cycle,sampledind,num_mut_seg,num_mut_fix,1-mean_fit,bal_freq,num_mut_haplo_bal_1,num_mut_haplo_bal_0,1),append=T);
			} else {	writeFile(paste("num_del_mut_N",N,"_sb",sb,"_sa",sa,"_rab",rab,"_mu",mu,"_equgen",equgen,"_totgen",totgen,"_sampledind",sampledind,"_rep",rep,"_bal0.txt",sep=""), paste(sim.cycle,sampledind,num_mut_seg,num_mut_fix,1-mean_fit,bal_freq,num_mut_haplo_bal_1,num_mut_haplo_bal_0,0),append=T);
			}
	}
      balmut=sim.subpopulations.individuals.haploidGenome1.mutationsOfType(m2);
        
      if (sim.getValue("counter") == 1 & size(balmut)==0) { // if the balancing allele is lost, the simulation restarts from tick 1
                sim.readFromPopulationFile(CHECKPOINT);
        }
}

GEN_TOT late(){
	if (sim.getValue("counter") == 1)
	{
		sim.simulationFinished(); // simulation ends
	} else {
		sim.setValue("counter", 1);
		sim.readFromPopulationFile(CHECKPOINT);
	}
}

reproduction(p1) {
        // parents are chosen in proportion to their fitness
        inds = p1.individuals;
        fitness = rep(1.123,N);
        
        balmut=sim.subpopulations.individuals.haploidGenome1.mutationsOfType(m2);
        
        if (sim.getValue("counter") == 1 & size(balmut)!=0)
        {
        freqbal=size(sim.subpopulations.individuals[sim.subpopulations.individuals.haploidGenome1.countOfMutationsOfType(m2)==1])/N;

        		for (i in seqLen(N)) {
         	       ind = inds[i];
            	    delmutcount=ind.haploidGenome1.countOfMutationsOfType(m1);
               	 balmutcount=ind.haploidGenome1.countOfMutationsOfType(m2);

                	fitness[i] = ((1.0-sa)^delmutcount)*((1.0-sb*freqbal)*balmutcount+(sb*(1.0-freqbal)-1.0)*(balmutcount-1.0));      
        		}
        	}
        	if (sim.getValue("counter") == 0)
        	{
				for (i in seqLen(N)) {
         	       ind = inds[i];
            	    delmutcount=ind.haploidGenome1.countOfMutationsOfType(m1);

                	fitness[i] = (1.0-sa)^delmutcount;      
        		}      	
        	}

        parents1 = sample(inds, N, replace=T, weights=fitness);
        parents2 = sample(inds, N, replace=T, weights=fitness);
        for (i in seqLen(N)) {
                breaks = sim.chromosome.drawBreakpoints(inds[i]);
                if (runif(1) <= 0.5) {
                        p1.addRecombinant(parents1[i].haploidGenome1, parents2[i].haploidGenome1,breaks,NULL,NULL,NULL,randomizeStrands = T);
                } else {
                        p1.addRecombinant(parents2[i].haploidGenome1, parents1[i].haploidGenome1,breaks,NULL,NULL,NULL,randomizeStrands = T);         
                }
        }
        self.active = 0;
}


survival(p1) {
        // survival is independent of fitness; parents die, offspring live
        return (individual.age == 0);
}
