  3.7323425645223618`*^9}},ExpressionUUID->"4482a2db-afe2-4ae3-be84-\
4686e12ade9a"],

Cell[CellGroupData[{

Cell["Original haploid derivation", "Subsection",
 CellChangeTimes->{{3.716013056797806*^9, 
  3.7160130604601383`*^9}},ExpressionUUID->"26d2aead-7417-4daf-959d-\
21f608bafb1a"],

Cell["\<\
Following Ewens\[CloseCurlyQuote] (2004) derivation of the fixation \
probability in his book for the haploid model we have:\
\>", "Text",
 CellChangeTimes->{{3.71537285078065*^9, 3.715372901810829*^9}, {
  3.7153729725901413`*^9, 3.7153729731571007`*^9}, {3.732248758522257*^9, 
  3.732248758903441*^9}},ExpressionUUID->"31dd2fb1-97df-431e-8b53-\
a9bef8ed90aa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Phi]", "[", "x_", "]"}], "=", 
  RowBox[{"Exp", "[", 
   RowBox[{"-", 
    RowBox[{"Simplify", "[", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "x"}], ")"}], " ", "x", " ", "\[Psi]"}], ")"}], 
         "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "x"}], ")"}], " ", "x"}], ")"}]}]}], ",", "x"}],
       "]"}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{
  3.5384147588788223`*^9, {3.715367853730687*^9, 3.7153678778675137`*^9}, {
   3.716012673003447*^9, 
   3.7160127021199293`*^9}},ExpressionUUID->"3d1dab59-c9ce-42d6-9223-\
10bfd92800ca"],

Cell[BoxData[
 SuperscriptBox["\[ExponentialE]", 
  RowBox[{
   RowBox[{"-", "2"}], " ", "x", " ", "\[Psi]"}]]], "Output",
 CellChangeTimes->{{3.538414747134181*^9, 3.53841476711264*^9}, 
   3.5384148609199667`*^9, 3.538418239842402*^9, 3.53841875018561*^9, 
   3.538428217082102*^9, {3.5384282965811462`*^9, 3.538428311883272*^9}, {
   3.715367835858491*^9, 3.7153678784635763`*^9}, 3.715373685202252*^9, 
   3.71601248108611*^9, {3.716012683447356*^9, 3.716012704522317*^9}, 
   3.732338863366905*^9, 3.764399541593306*^9, 3.775971682332596*^9, 
   3.775972094153439*^9, 3.775994170337784*^9, 
   3.775994459360318*^9},ExpressionUUID->"0f504ceb-b3d6-4472-a4b5-\
b28d6102360e"]
}, Open  ]],

Cell["where \[Psi]=Ns and", "Text",
 CellChangeTimes->{{3.7153732381466923`*^9, 
  3.715373254281949*^9}},ExpressionUUID->"6e93d919-baad-49d0-a341-\
d0dbaa404d82"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Sx", "[", "x_", "]"}], "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{"\[Phi]", "[", "x", "]"}], ",", "x"}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{
  3.538414758916375*^9, {3.7153678452824697`*^9, 3.715367873569085*^9}, {
   3.716012710908259*^9, 
   3.716012711863555*^9}},ExpressionUUID->"f6c7d2d7-dab5-407c-abe6-\
949afa561b90"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "2"}], " ", "x", " ", "\[Psi]"}]], 
   RowBox[{"2", " ", "\[Psi]"}]]}]], "Output",
 CellChangeTimes->{{3.5384147472192*^9, 3.538414767179805*^9}, 
   3.538414860984395*^9, 3.53841823999895*^9, 3.53841875025284*^9, 
   3.5384282171201057`*^9, {3.53842829661056*^9, 3.538428311916356*^9}, {
   3.715367860292296*^9, 3.715367880712193*^9}, 3.7153736853024607`*^9, 
   3.716012483655088*^9, 3.716012712392651*^9, 3.732338866083641*^9, 
   3.764399544484703*^9, 3.7759716823826647`*^9, 3.775972094200932*^9, 
   3.7759941703781757`*^9, 
   3.7759944594150143`*^9},ExpressionUUID->"d2ba31fe-0453-4a34-be42-\
7dcf239d7465"]
}, Open  ]],

Cell["which are used in the fixation probability (Eq. 4.17):", "Text",
 CellChangeTimes->{{3.5384183184914618`*^9, 3.538418320939127*^9}, {
  3.715372985060822*^9, 3.715372996122485*^9}, {3.716012509661265*^9, 
  3.716012513165012*^9}, {3.726476995279603*^9, 3.7264770010202503`*^9}, {
  3.7322487681520557`*^9, 
  3.732248770342704*^9}},ExpressionUUID->"3a5945a9-6ccc-46aa-ab2d-\
f08ae1232a21"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"fix", "[", 
   RowBox[{"p0_", ",", "\[Psi]_"}], "]"}], "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Sx", "[", "x0", "]"}], "-", 
       RowBox[{"Sx", "[", "0", "]"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Sx", "[", "1", "]"}], "-", 
       RowBox[{"Sx", "[", "0", "]"}]}], ")"}]}], "/.", 
    RowBox[{"x0", "\[Rule]", "p0"}]}], "]"}]}]], "Input",
 CellChangeTimes->{
  3.538414758967661*^9, {3.538418222669917*^9, 3.5384182253206663`*^9}, 
   3.538418316800583*^9, {3.538428129111928*^9, 
   3.538428129683345*^9}},ExpressionUUID->"1608dce5-e28c-452a-bcd1-\
c720e5ba8dab"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"2", " ", "\[Psi]"}]], " ", 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "2"}], " ", "p0", " ", "\[Psi]"}]]}], ")"}]}], 
  RowBox[{
   RowBox[{"-", "1"}], "+", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"2", " ", "\[Psi]"}]]}]]], "Output",
 CellChangeTimes->{{3.538414747257196*^9, 3.538414767218305*^9}, 
   3.538414861019249*^9, {3.538418226845193*^9, 3.538418240028077*^9}, 
   3.538418750285808*^9, 3.538428217165503*^9, {3.538428277844006*^9, 
   3.538428311950111*^9}, 3.715367884080039*^9, 3.715373685370932*^9, 
   3.716012494050972*^9, 3.716012715763875*^9, 3.7323388692678413`*^9, 
   3.764399547562439*^9, 3.775971682430863*^9, 3.7759720942492523`*^9, 
   3.7759941704213667`*^9, 
   3.775994459458889*^9},ExpressionUUID->"2a2f3cde-f9ae-45c3-933e-\
d465b0545da6"]
}, Open  ]],

Cell["\<\
The time spent at frequency x < p (conditional on fixation) is then given by \
(4.22):\
\>", "Text",
 CellChangeTimes->{{3.538418323235217*^9, 3.538418345171279*^9}, {
  3.715373003155993*^9, 3.715373008602098*^9}, {3.71601251740786*^9, 
  3.716012517869953*^9}},ExpressionUUID->"f0d0c807-dbfa-4ab6-9644-\
4d74574a8ffb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   FractionBox[
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"fix", "[", 
        RowBox[{"p0", ",", "\[Psi]"}], "]"}]}], ")"}]}], 
    RowBox[{"(", 
     RowBox[{"x", " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", "x"}], ")"}], 
      RowBox[{"\[Phi]", "[", "x", "]"}]}], ")"}]], 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{"\[Phi]", "[", "y", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "0", ",", "x"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.538417549943575*^9, 3.538417633944564*^9}, {
   3.53841773219106*^9, 3.5384177335841312`*^9}, {3.538417769782003*^9, 
   3.538417827623353*^9}, {3.538418301478447*^9, 3.538418306318309*^9}, 
   3.538418661076186*^9, {3.5384190322999983`*^9, 3.5384190647389927`*^9}, {
   3.538428149630438*^9, 3.538428155842249*^9}, {3.716012801990424*^9, 
   3.7160128038952627`*^9}, {3.7160129133167477`*^9, 
   3.716012938736637*^9}},ExpressionUUID->"ad400f7f-0820-449f-b5d0-\
812aa2a5893d"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "2"}], " ", "p0", " ", "\[Psi]"}]], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"2", " ", "\[Psi]"}]]}], "+", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", " ", "p0", " ", "\[Psi]"}]]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", " ", "x", " ", "\[Psi]"}]]}], ")"}]}], 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", " ", "\[Psi]"}]]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "x"}], ")"}], " ", "x", " ", 
   "\[Psi]"}]]], "Output",
 CellChangeTimes->{{3.5384176012668543`*^9, 3.538417624578463*^9}, 
   3.5384177341087027`*^9, {3.538417812983864*^9, 3.538417823656986*^9}, 
   3.538418307844966*^9, 3.538418348567069*^9, 3.5384183792682047`*^9, {
   3.5384184260102*^9, 3.5384184525124617`*^9}, 3.538418492325158*^9, 
   3.538418548140081*^9, 3.538418662331952*^9, 3.538418863878461*^9, {
   3.538419054974894*^9, 3.538419065115097*^9}, 3.538428217377598*^9, {
   3.5384282997506332`*^9, 3.538428312034004*^9}, 3.715367931162347*^9, 
   3.715368050569024*^9, 3.715373685441148*^9, 3.71601293947556*^9, 
   3.732338871616721*^9, 3.764399549664792*^9, 3.7759716825378637`*^9, 
   3.775972094333832*^9, 3.775994170513646*^9, 
   3.775994459549403*^9},ExpressionUUID->"12c703d8-dce4-41d6-8a34-\
0f104cad1681"]
}, Open  ]],

Cell["\<\
while the time spent at frequency x > p (conditional on fixation) is given by \
(4.23)\
\>", "Text",
 CellChangeTimes->{{3.538418323235217*^9, 3.538418345171279*^9}, {
  3.7153695826722517`*^9, 3.715369582863048*^9}, {3.715373033123086*^9, 
