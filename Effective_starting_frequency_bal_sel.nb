  3.7759941707712793`*^9, 
  3.775994459876285*^9},ExpressionUUID->"c0e189ba-2b22-4c26-8947-\
721f86ec9f58"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Haploid derivation with balancing selection", "Subsection",
 CellChangeTimes->{{3.716013056797806*^9, 3.7160130604601383`*^9}, {
  3.936855084845999*^9, 
  3.936855096156818*^9}},ExpressionUUID->"f7af6187-feb7-4856-ae60-\
702f66d00960"],

Cell["\<\
Using the approximate change in frequency of haplotype ab under balancing \
selection\
\>", "Text",
 CellChangeTimes->{{3.938254164950437*^9, 
  3.938254191477512*^9}},ExpressionUUID->"37c79b75-45ed-4eac-9117-\
070593f44e0d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pabs", "=", 
   RowBox[{
    RowBox[{"pab", 
     RowBox[{"(", 
      RowBox[{"1", "-", "pab"}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"sbp", "/", "Nt"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"pab", 
           RowBox[{"(", 
            RowBox[{"2", "-", 
             RowBox[{"(", 
              RowBox[{"sdp", "/", "Nt"}], ")"}]}], ")"}]}]}], ")"}]}], "-", 
       RowBox[{"(", 
        RowBox[{"sdp", "/", "Nt"}], ")"}]}], ")"}]}], "+", "pab"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.936874593494471*^9, 3.9368746592672977`*^9}, {
   3.936874961327449*^9, 3.936874972729781*^9}, 3.936956441543379*^9, {
   3.9369612287721863`*^9, 3.93696123156619*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"2dbd0c46-da84-4ff0-9762-4f27f438f821"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Limit", "[", 
  RowBox[{
   RowBox[{"Nt", 
    RowBox[{"(", 
     RowBox[{"pabs", "-", "pab"}], ")"}]}], ",", 
   RowBox[{"Nt", "->", "Infinity"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.936955818688188*^9, 3.936955822574209*^9}, {
  3.936955893879505*^9, 3.936955986141238*^9}, {3.936956060733404*^9, 
  3.936956063003549*^9}, {3.9369563112483387`*^9, 3.936956315423668*^9}},
 CellLabel->"In[36]:=",ExpressionUUID->"bbff3ad4-a515-4647-bf76-8abd0e64a94f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pab", " ", "sbp"}], "-", 
  RowBox[{"3", " ", 
   SuperscriptBox["pab", "2"], " ", "sbp"}], "+", 
  RowBox[{"2", " ", 
   SuperscriptBox["pab", "3"], " ", "sbp"}], "-", 
  RowBox[{"pab", " ", "sdp"}], "+", 
  RowBox[{
   SuperscriptBox["pab", "2"], " ", "sdp"}]}]], "Output",
 CellChangeTimes->{3.936956316749866*^9, 3.936956446093562*^9, 
  3.936961236093239*^9},
 CellLabel->"Out[36]=",ExpressionUUID->"f5ef88fc-09c3-483f-bc67-ba74e141234d"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"%", "-", 
   RowBox[{"(", 
    RowBox[{"pab", 
     RowBox[{"(", 
      RowBox[{"1", "-", "pab"}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"sbp", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"2", "pab"}]}], ")"}]}], "-", "sdp"}], ")"}]}], ")"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.936956702539381*^9, 3.9369567268734617`*^9}, {
  3.9369612436466103`*^9, 3.936961252476707*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"e9a41c80-22ee-48d6-91a1-6162163a9af0"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.9369567273460283`*^9, 3.936961253479991*^9},
 CellLabel->"Out[37]=",ExpressionUUID->"f4cd389c-a30c-4fd6-bff3-4e66093e6283"]
}, Open  ]],

Cell["We thus have with balancing selection:", "Text",
 CellChangeTimes->{{3.936958242594384*^9, 3.936958255871059*^9}, {
  3.9382540957914677`*^9, 
  3.938254118664892*^9}},ExpressionUUID->"445263ac-73f9-44ea-9a2e-\
950c3d7b6950"],

Cell[BoxData[
 RowBox[{
  RowBox[{"coeff", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Mu]", "->", 
      RowBox[{"pab", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"sbp", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"pab", 
             RowBox[{"(", 
              RowBox[{"2", "-", "sdp"}], ")"}]}]}], ")"}]}], "-", "sdp"}], 
        ")"}]}]}], ",", 
     RowBox[{"\[Sigma]2", "->", 
      RowBox[{"pab", 
       RowBox[{"(", 
        RowBox[{"1", "-", "pab"}], ")"}]}]}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9382484751257553`*^9, 3.9382485593570747`*^9}, 
   3.938248620290113*^9, {3.938248964624568*^9, 3.9382490363571167`*^9}, {
   3.938249108797702*^9, 3.938249110140967*^9}, {3.938249140660471*^9, 
   3.9382491783959923`*^9}, {3.9382508041736403`*^9, 3.9382508437571487`*^9}, 
   3.938253857416801*^9},
 CellLabel->"In[65]:=",ExpressionUUID->"1613d1ca-9069-4b72-a735-188d638ceb37"],

Cell[BoxData[
 RowBox[{
  RowBox[{"equpab", "=", 
   RowBox[{"{", 
    RowBox[{"pabe", "->", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"sb", "-", "sd"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"sb", 
        RowBox[{"(", 
         RowBox[{"2", "-", "sd"}], ")"}]}], ")"}]}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[36]:=",ExpressionUUID->"d213f29e-64fd-48a8-9cb3-56424f05ded7"],

Cell["\<\
Following Ewens\[CloseCurlyQuote] (2004) derivation of the fixation \
probability in his book for the haploid model we have:\
\>", "Text",
 CellChangeTimes->{{3.71537285078065*^9, 3.715372901810829*^9}, {
  3.7153729725901413`*^9, 3.7153729731571007`*^9}, {3.732248758522257*^9, 
  3.732248758903441*^9}},ExpressionUUID->"31bca976-217f-4d09-9c28-\
19946ac847df"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Phi]", "[", "pab_", "]"}], "=", 
  RowBox[{"Exp", "[", 
   RowBox[{"-", 
    RowBox[{"Simplify", "[", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"2", 
        RowBox[{"\[Mu]", "/", "\[Sigma]2"}]}], ",", "pab"}], "]"}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{
  3.5384147588788223`*^9, {3.715367853730687*^9, 3.7153678778675137`*^9}, {
   3.716012673003447*^9, 3.7160127021199293`*^9}, {3.936959624954777*^9, 
   3.936959634834344*^9}, {3.936959678742217*^9, 3.9369597123223248`*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"e87afe30-e63e-40cf-ad04-37e804674856"],

Cell[BoxData[
 SuperscriptBox["\[ExponentialE]", 
  RowBox[{"-", 
   FractionBox[
    RowBox[{"2", " ", "pab", " ", "\[Mu]"}], "\[Sigma]2"]}]]], "Output",
 CellChangeTimes->{{3.538414747134181*^9, 3.53841476711264*^9}, 
   3.5384148609199667`*^9, 3.538418239842402*^9, 3.53841875018561*^9, 
   3.538428217082102*^9, {3.5384282965811462`*^9, 3.538428311883272*^9}, {
   3.715367835858491*^9, 3.7153678784635763`*^9}, 3.715373685202252*^9, 
   3.71601248108611*^9, {3.716012683447356*^9, 3.716012704522317*^9}, 
   3.732338863366905*^9, 3.764399541593306*^9, 3.775971682332596*^9, 
   3.775972094153439*^9, 3.775994170337784*^9, 3.775994459360318*^9, 
   3.9369596370007887`*^9, {3.9369596809410458`*^9, 3.9369597133361998`*^9}, 
   3.936962458436151*^9, {3.936984052622365*^9, 3.9369840674480953`*^9}, 
   3.937026864607605*^9, 3.937302125350841*^9, 3.937302345155136*^9, 
   3.9373030731080027`*^9, 3.937379281347245*^9, 3.9382491886897163`*^9},
 CellLabel->"Out[4]=",ExpressionUUID->"627d202a-f464-431f-a569-d2c965c0e669"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Sx", "[", "pab_", "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{"\[Phi]", "[", "pab", "]"}], ",", "pab"}], "]"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{
  3.538414758916375*^9, {3.7153678452824697`*^9, 3.715367873569085*^9}, {
   3.716012710908259*^9, 3.716012711863555*^9}, {3.9369597387201138`*^9, 
   3.936959749038973*^9}, {3.9373023375032*^9, 3.9373023381649113`*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"40baa1c8-cf87-43ee-8bbd-f8c7093d4ad7"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"2", " ", "pab", " ", "\[Mu]"}], "\[Sigma]2"]}]], " ", 
