             FractionBox[
              RowBox[{"2", " ", 
               RowBox[{"(", 
                RowBox[{"sb", "+", 
                 RowBox[{"pab0", " ", "sb", " ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"-", "2"}], "+", "sd"}], ")"}]}], "-", "sd"}], 
                ")"}], " ", 
