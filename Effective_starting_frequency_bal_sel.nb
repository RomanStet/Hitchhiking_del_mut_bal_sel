  3.71601252028482*^9}},ExpressionUUID->"43599754-9265-4196-b8da-\
479f0f596cb9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   FractionBox[
    RowBox[{"2", " ", 
     RowBox[{"fix", "[", 
      RowBox[{"p0", ",", "\[Psi]"}], "]"}]}], 
    RowBox[{"(", 
     RowBox[{"x", " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", "x"}], ")"}], 
      RowBox[{"\[Phi]", "[", "x", "]"}]}], ")"}]], 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{"\[Phi]", "[", "y", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "x", ",", "1"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.538417549943575*^9, 3.538417633944564*^9}, {
   3.53841773219106*^9, 3.5384177335841312`*^9}, {3.538418293423188*^9, 
   3.538418297110195*^9}, {3.538418947597419*^9, 3.538418948260187*^9}, {
   3.538419015075096*^9, 3.538419017274126*^9}, 3.538428155861058*^9, {
   3.7160125573907957`*^9, 3.716012557500266*^9}, {3.716012588349245*^9, 
   3.716012636283762*^9}, {3.716012722682192*^9, 3.716012740998653*^9}, 
   3.7160127905020638`*^9, {3.7160128917964373`*^9, 
   3.716012891906135*^9}},ExpressionUUID->"bbaf81cd-d731-4e5b-9af0-\
bf4c998d6a48"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "2"}], " ", "p0", " ", "\[Psi]"}]], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", " ", "p0", " ", "\[Psi]"}]]}], ")"}], " ", 
