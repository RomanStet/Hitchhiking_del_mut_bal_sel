   3.775972094455456*^9, 3.775994170577983*^9, 
   3.775994459615244*^9},ExpressionUUID->"b5c14235-91a6-4833-b303-\
d7501257d5be"]
}, Open  ]],

Cell["\<\
Assuming p0=1/N, only the latter is relevant (the system cannot spend time \
below this frequency if it will fix).\
\>", "Text",
 CellChangeTimes->{{3.715373068136392*^9, 
  3.715373099613536*^9}},ExpressionUUID->"b7e8ce27-4daa-46c2-a258-\
48c1a665593d"],

Cell[TextData[{
 "By comparison, the time spent at frequency x in the deterministic process \
is given by: ",
 Cell[BoxData[
  FractionBox["1", 
   RowBox[{"\[Psi]", 
    RowBox[{"(", 
     RowBox[{"1", "-", "x"}], ")"}], " ", "x", " "}]]],
  CellChangeTimes->{{3.5384176012668543`*^9, 3.538417624578463*^9}, 
    3.5384177341087027`*^9, 3.538418297755794*^9, 3.538418396304264*^9, {
    3.538418727332882*^9, 3.538418755178636*^9}, 3.53841889808648*^9, 
    3.5384190196830072`*^9, 3.5384282176050777`*^9, 3.5384283121660748`*^9, 
    3.7153681522045183`*^9},ExpressionUUID->
  "45be95ca-caec-4961-adb2-77a117d80c5b"],
 " (this is obtained by rearranging dx/dt = sx(1-x) and then measuring time \
in units of N generations).  "
}], "Text",
 CellChangeTimes->{{3.715373211115893*^9, 3.7153732322867107`*^9}, {
  3.715373281189666*^9, 3.715373288640683*^9}, {3.715373323237982*^9, 
  3.715373369401412*^9}},ExpressionUUID->"cee34684-0de0-411e-aee9-\
488c6924937e"],

Cell["\<\
A simple estimate of the acceleration is given by taking the time spent at \
x=p0 in the diffusion process and equating this to the time in the \
deterministic process at an accelerated position x=\[Alpha] p0.\
\>", "Text",
 CellChangeTimes->{{3.715373588802499*^9, 3.715373654853674*^9}, {
  3.7153776483453217`*^9, 
  3.715377648697249*^9}},ExpressionUUID->"0de45c79-9b41-4c5b-b364-\
eb6e15d7cce1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "2"}], " ", "p0", " ", "\[Psi]"}]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"2", " ", "p0", " ", "\[Psi]"}]]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"2", " ", "\[Psi]"}]]}], "+", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"2", " ", "x", " ", "\[Psi]"}]]}], ")"}]}], 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"2", " ", "\[Psi]"}]]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "x"}], ")"}], " ", "x", " ", "\[Psi]"}]], "/.", 
  RowBox[{"x", "\[Rule]", "p0"}]}]], "Input",
 CellChangeTimes->{
  3.7153708927023478`*^9, {3.715373668297166*^9, 3.715373697490733*^9}, {
   3.716013008177504*^9, 
   3.71601301443253*^9}},ExpressionUUID->"d52b8f6f-fd38-4ac4-9f73-\
fdc5e93c0741"],

