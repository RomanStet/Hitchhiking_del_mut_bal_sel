}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"(", 
  RowBox[{
   FractionBox["1", 
    RowBox[{"\[Psi]", 
     RowBox[{"(", 
      RowBox[{"1", "-", "x"}], ")"}], " ", "x"}]], "/.", 
   RowBox[{"x", "\[Rule]", 
    RowBox[{"\[Alpha]", " ", "p0"}]}]}], ")"}]], "Input",
 CellChangeTimes->{{3.715370902739345*^9, 3.715370922581091*^9}, {
  3.7153735735580587`*^9, 3.715373575909934*^9}, {3.715373699853587*^9, 
  3.7153737067803307`*^9}},ExpressionUUID->"a6ad4d9c-5bf0-4777-ad41-\
198ff9a9aef4"],

Cell[BoxData[
 FractionBox["1", 
  RowBox[{"p0", " ", "\[Alpha]", " ", 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     RowBox[{"p0", " ", "\[Alpha]"}]}], ")"}], " ", "\[Psi]"}]]], "Output",
 CellChangeTimes->{{3.715370903105452*^9, 3.7153709291915693`*^9}, 
   3.715373708557721*^9, 3.732338881063106*^9, 3.764399564036408*^9, 
   3.775971682692389*^9, 3.77597209455129*^9, 3.775994170645406*^9, 
   3.7759944596920433`*^9},ExpressionUUID->"b8dca478-5deb-4bc5-b13f-\
225510d9a357"]
}, Open  ]],

Cell[TextData[{
 "Given that p0 is very small, the latter can be approximated as ",
 Cell[BoxData[
  FractionBox["1", 
   RowBox[{"p0", " ", "\[Alpha]", " ", "\[Psi]"}]]],
  CellChangeTimes->{{3.715370903105452*^9, 3.7153709291915693`*^9}, 
    3.715373708557721*^9},ExpressionUUID->
  "77c29f23-8c19-4c41-b0c2-22f1d3718322"],
 ", allowing us to solve for the acceleration:"
}], "Text",
 CellChangeTimes->{{3.715373714888665*^9, 
  3.715373741101791*^9}},ExpressionUUID->"8c174f2d-dde1-4823-8479-\
b768466ee32f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "2"}], " ", "p0", " ", "\[Psi]"}]], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"2", " ", "p0", " ", "\[Psi]"}]]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"2", " ", "\[Psi]"}]]}], "+", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"2", " ", "p0", " ", "\[Psi]"}]]}], ")"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"2", " ", "\[Psi]"}]]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "p0"}], ")"}], " ", "p0", " ", "\[Psi]"}]], 
     "==", 
     FractionBox["1", 
      RowBox[{"p0", " ", "\[Alpha]", " ", "\[Psi]"}]]}], ",", "\[Alpha]"}], 
   "]"}], "//", "Flatten"}]], "Input",
 CellChangeTimes->{{3.715373745876522*^9, 3.715373768955626*^9}, 
   3.716013020833968*^9},ExpressionUUID->"1a6bf94c-5c1c-4ee4-a5c9-\
762626d3d8d6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\[Alpha]", "\[Rule]", 
   FractionBox[
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", " ", "p0", " ", "\[Psi]"}]], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"2", " ", "\[Psi]"}]]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", "p0"}], ")"}]}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"2", " ", "p0", " ", "\[Psi]"}]]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"2", " ", "\[Psi]"}]]}], "+", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"2", " ", "p0", " ", "\[Psi]"}]]}], ")"}]}]]}], 
  "}"}]], "Output",
 CellChangeTimes->{{3.7153737532944117`*^9, 3.715373769480694*^9}, 
   3.715373835406246*^9, 3.716013022151434*^9, 3.73233888341356*^9, 
   3.764399568680594*^9, 3.775971682727378*^9, 3.7759720946003304`*^9, 
   3.775994170687202*^9, 
   3.775994459770857*^9},ExpressionUUID->"e8c32a2b-97b0-446b-81e5-\
bf9828cfb755"]
}, Open  ]],

Cell["To leading order in p0, this is:", "Text",
 CellChangeTimes->{{3.715373822282145*^9, 
  3.715373832009392*^9}},ExpressionUUID->"80d64dd1-d1ad-476e-9b6a-\
d58ba796d2e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Normal", "[", 
  RowBox[{"Series", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\[Alpha]", "/.", "%"}], ")"}], ",", 
    RowBox[{"{", 
     RowBox[{"p0", ",", "0", ",", 
      RowBox[{"-", "1"}]}], "}"}]}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.715373802366824*^9, 
  3.715373852859933*^9}},ExpressionUUID->"0a5f25f5-c516-4201-9ed4-\
d3b4673790e5"],

Cell[BoxData[
 FractionBox["1", 
  RowBox[{"2", " ", "p0", " ", "\[Psi]"}]]], "Output",
 CellChangeTimes->{{3.7153738099860373`*^9, 3.7153738125194893`*^9}, 
   3.715373855057098*^9, 3.716013024911694*^9, 3.732338885897916*^9, 
   3.764399572371951*^9, 3.775971682768168*^9, 3.775972094650257*^9, 
   3.775994170724495*^9, 
   3.7759944598265553`*^9},ExpressionUUID->"a787fb69-ea44-4951-9d78-\
61d89b6d7555"]
}, Open  ]],

Cell[TextData[{
 "Setting p0=1/N and \[Psi]=Ns, we get that the acceleration is approximately \
equivalent to starting at an allele frequency that is ",
 Cell[BoxData[
  FractionBox["1", 
   RowBox[{"2", " ", "s"}]]],
  CellChangeTimes->{{3.7153738099860373`*^9, 3.7153738125194893`*^9}, 
    3.715373855057098*^9},ExpressionUUID->
  "adb629e4-4989-4d4d-a322-f3e2a770a1c6"],
 " times higher than the initial allele frequency, as used in the simulations \
of Otto and Barton (1997)."
}], "Text",
 CellChangeTimes->{{3.715373865647772*^9, 3.715373896910432*^9}, {
   3.715374114895812*^9, 3.715374158818366*^9}, 
   3.715377667539838*^9},ExpressionUUID->"c007a42d-6a2d-45df-bf96-\
549acd889b50"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  FractionBox["1", 
   RowBox[{"2", " ", "p0", " ", "\[Psi]"}]], "/.", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"p0", "\[Rule]", 
     FractionBox["1", "Na"]}], ",", 
    RowBox[{"\[Psi]", "\[Rule]", 
     RowBox[{"Na", " ", "s"}]}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.7160130323348503`*^9, 
  3.7160130477729588`*^9}},ExpressionUUID->"735a9eb1-e0b6-43d2-b73b-\
313f357120b3"],

Cell[BoxData[
 FractionBox["1", 
  RowBox[{"2", " ", "s"}]]], "Output",
 CellChangeTimes->{3.716013048381085*^9, 3.732338890173134*^9, 
