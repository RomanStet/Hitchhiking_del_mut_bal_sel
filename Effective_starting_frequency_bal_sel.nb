                 RowBox[{"pab", " ", "sbp", " ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"-", "2"}], "+", "sdp"}], ")"}]}], "-", "sdp"}], 
                ")"}]}], 
              RowBox[{
               RowBox[{"(", 
