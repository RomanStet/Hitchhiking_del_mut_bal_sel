Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"fix", "[", "pab0_", "]"}], "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Sx", "[", "x0", "]"}], "-", 
       RowBox[{"Sx", "[", "0", "]"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Sx", "[", "pabe", "]"}], "-", 
       RowBox[{"Sx", "[", "0", "]"}]}], ")"}]}], "/.", 
    RowBox[{"x0", "\[Rule]", "pab0"}]}], "]"}]}]], "Input",
 CellChangeTimes->{
  3.538414758967661*^9, {3.538418222669917*^9, 3.5384182253206663`*^9}, 
   3.538418316800583*^9, {3.538428129111928*^9, 3.538428129683345*^9}, {
   3.936959887079953*^9, 3.936959929485978*^9}, {3.9373023662859898`*^9, 
   3.937302370868691*^9}, {3.9373047959069157`*^9, 3.9373048174095173`*^9}, {
   3.937304856944971*^9, 3.9373048589283648`*^9}, {3.937305021961123*^9, 
   3.937305023894545*^9}, {3.93737938406598*^9, 3.937379384216764*^9}, 
   3.937379420297855*^9, {3.937391402156514*^9, 3.93739140221282*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"c8807033-385b-445e-afaa-688a3a52b884"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{"pab0", "-", "pabe"}], ")"}], " ", "\[Mu]"}], "\[Sigma]2"]}]],
    " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     SuperscriptBox["\[ExponentialE]", 
      FractionBox[
       RowBox[{"2", " ", "pab0", " ", "\[Mu]"}], "\[Sigma]2"]]}], ")"}]}], 
  RowBox[{
   RowBox[{"-", "1"}], "+", 
   SuperscriptBox["\[ExponentialE]", 
    FractionBox[
