Cell[TextData[{
 "Setting pab0=1/N, sbp=N sb and sdp=N sd, we get that the acceleration is \
approximately equivalent to starting at an allele frequency that is ",
 Cell[BoxData[
  FractionBox["1", 
   RowBox[{"2", " ", 
    SubscriptBox["s", "net"]}]]],
  CellChangeTimes->{{3.7153738099860373`*^9, 3.7153738125194893`*^9}, 
    3.715373855057098*^9},ExpressionUUID->
  "03d95176-3b29-416c-8ac7-53f026ca4b19"],
 " times higher than the initial allele frequency."
}], "Text",
