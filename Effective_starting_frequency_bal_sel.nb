   3.764399544484703*^9, 3.7759716823826647`*^9, 3.775972094200932*^9, 
   3.7759941703781757`*^9, 3.7759944594150143`*^9, 3.93695974970708*^9, 
   3.936962468222197*^9, {3.936984059018262*^9, 3.936984069411767*^9}, 
