Cell["which are used in the fixation probability (Eq. 4.17):", "Text",
 CellChangeTimes->{{3.5384183184914618`*^9, 3.538418320939127*^9}, {
  3.715372985060822*^9, 3.715372996122485*^9}, {3.716012509661265*^9, 
